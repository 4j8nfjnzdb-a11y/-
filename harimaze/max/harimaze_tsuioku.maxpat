          "patcher": {
            "fileversion": 1,
            "appversion": {
              "major": 8,
              "minor": 6,
              "revision": 0,
              "architecture": "x64",
              "modernui": 1
            },
            "classnamespace": "dsp.gen",
            "rect": [
              80.0,
              80.0,
              840.0,
              760.0
            ],
            "bglocked": 0,
            "openinpresentation": 0,
            "default_fontsize": 12.0,
            "default_fontface": 0,
            "default_fontname": "Arial",
            "gridonopen": 1,
            "gridsize": [
              15.0,
              15.0
            ],
            "gridsnaponopen": 1,
            "objectsnaponopen": 1,
            "statusbarvisible": 2,
            "toolbarvisible": 1,
            "lefttoolbarpinned": 0,
            "toptoolbarpinned": 0,
            "righttoolbarpinned": 0,
            "bottomtoolbarpinned": 0,
            "toolbars_unpinned_last_save": 0,
            "tallnewobj": 0,
            "boxanimatetime": 200,
            "enablehscroll": 1,
            "enablevscroll": 1,
            "devicewidth": 0.0,
            "description": "",
            "digest": "",
            "tags": "",
            "style": "",
            "subpatcher_template": "",
            "assistshowspatchername": 0,
            "boxes": [
              {
                "box": {
                  "maxclass": "codebox",
                  "code": "// harimaze / TSUIOKU - memory tape\r\n// The input is written into a circular tape. Three heads keep recalling\r\n// moments from the past: they loop them, run them backwards, change speed,\r\n// then let go. What they recall is written back, eroded, so memories of\r\n// memories pile up and wear down. Freeze stops writing.\r\n// in1, in2 : live input (used when source = 0)\r\n// out1 : left    out2 : right\r\n// out3 : write position 0..1    out4 : head 1 read position 0..1\r\n\r\nBuffer tape(\"hz_tsuioku_tape\");\r\nBuffer feed(\"hz_tsuioku_file\");\r\nData hd(3, 8);\r\n\r\nParam source(1);\r\nParam ingain(0.8);\r\nParam recall(0.4);\r\nParam span(0.6);\r\nParam loop(900);\r\nParam rev(0.35);\r\nParam varispeed(0.3);\r\nParam wow(0.2);\r\nParam feedback(0.45);\r\nParam erode(0.4);\r\nParam freeze(0);\r\nParam dry(0.3);\r\nParam level(0.8);\r\n\r\nHistory wp(0);\r\nHistory fpos(0);\r\nHistory filled(0);\r\nHistory lp1(0);\r\nHistory lp2(0);\r\nHistory wowph(0);\r\nHistory dcx1(0);\r\nHistory dcy1(0);\r\nHistory dcx2(0);\r\nHistory dcy2(0);\r\n\r\ntl = max(dim(tape), 2);\r\nfl = max(dim(feed), 2);\r\nfch = 0;\r\nif (channels(feed) > 1) {\r\n\tfch = 1;\r\n}\r\ntch = 0;\r\nif (channels(tape) > 1) {\r\n\ttch = 1;\r\n}\r\n\r\nw = wp;\r\nfp = fpos;\r\nfd = filled;\r\n\r\n// input: live (in1/in2) or the file buffer played as a loop\r\nfi = floor(fp);\r\nfL = peek(feed, fi, 0);\r\nfR = peek(feed, fi, fch);\r\nfp = wrap(fp + 1, 0, fl);\r\ninL = in1;\r\ninR = in2;\r\nif (source > 0.5) {\r\n\tinL = fL;\r\n\tinR = fR;\r\n}\r\ninL = inL * ingain;\r\ninR = inR * ingain;\r\n\r\nwv = sin(twopi * wowph);\r\nwph = wowph + 0.55 / samplerate;\r\nwph = wph - floor(wph);\r\n\r\nsumL = 0;\r\nsumR = 0;\r\nh0 = 0;\r\ni = 0;\r\nhls = 0;\r\nhll = 256;\r\nhrel = 0;\r\nhsp = 1;\r\nhtm = 0;\r\nhen = 0;\r\nhst = 0;\r\nhpn = 0.5;\r\nback = 0;\r\navail = 0;\r\nyoung = 1;\r\nspv = 1;\r\nfade = 1;\r\nedge = 1;\r\nrpos = 0;\r\nk0 = 0;\r\nk1 = 0;\r\nkf = 0;\r\nvL = 0;\r\nvR = 0;\r\nmono = 0;\r\ngg = 0;\r\nmaxll = tl * 0.25;\r\n\r\nfor (i = 0; i < 3; i += 1) {\r\n\thls = peek(hd, i, 0);\r\n\thll = max(peek(hd, i, 1), 256);\r\n\threl = peek(hd, i, 2);\r\n\thsp = peek(hd, i, 3);\r\n\thtm = peek(hd, i, 4) - 1;\r\n\then = peek(hd, i, 5);\r\n\thst = peek(hd, i, 6);\r\n\thpn = peek(hd, i, 7);\r\n\tif (htm <= 0 && hst < 0.5) {\r\n\t\thst = 1;\r\n\t}\r\n\tif (hst > 0.5) {\r\n\t\t// let go of the old memory, then recall a new one\r\n\t\then = hen - 1 / mstosamps(60);\r\n\t\tif (hen <= 0) {\r\n\t\t\then = 0;\r\n\t\t\thst = 0;\r\n\t\t\thll = clamp(mstosamps(loop * (0.5 + (noise() * 0.5 + 0.5))), 256, maxll);\r\n\t\t\tavail = max(min(fd, tl) - 2 * hll, 0);\r\n\t\t\tback = hll + (0.02 + clamp(span, 0, 1) * 0.95 * (noise() * 0.5 + 0.5)) * avail;\r\n\t\t\thls = wrap(w - back, 0, tl);\r\n\t\t\thsp = 1 + varispeed * noise() * 0.5;\r\n\t\t\tif ((noise() * 0.5 + 0.5) < varispeed * 0.3) {\r\n\t\t\t\thsp = 2;\r\n\t\t\t\tif (noise() > 0) {\r\n\t\t\t\t\thsp = 0.5;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\threl = 0;\r\n\t\t\tif ((noise() * 0.5 + 0.5) < rev) {\r\n\t\t\t\thsp = 0 - hsp;\r\n\t\t\t\threl = hll - 1;\r\n\t\t\t}\r\n\t\t\tyoung = clamp(fd / (tl * 0.3), 0.15, 1);\r\n\t\t\thtm = mstosamps(mix(14000, 700, clamp(recall, 0, 1)) * (0.5 + (noise() * 0.5 + 0.5))) * young;\r\n\t\t\thpn = clamp(0.5 + 0.8 * noise() * 0.5, 0, 1);\r\n\t\t}\r\n\t} else {\r\n\t\then = min(hen + 1 / mstosamps(120), 1);\r\n\t}\r\n\tspv = hsp * (1 + wow * 0.015 * wv * (0.6 + 0.4 * i));\r\n\threl = wrap(hrel + spv, 0, hll);\r\n\tfade = max(min(mstosamps(15), hll * 0.25), 1);\r\n\tedge = clamp(min(hrel, hll - hrel) / fade, 0, 1);\r\n\trpos = wrap(hls + hrel, 0, tl);\r\n\tk0 = floor(rpos);\r\n\tkf = rpos - k0;\r\n\tk1 = wrap(k0 + 1, 0, tl);\r\n\tvL = mix(peek(tape, k0, 0), peek(tape, k1, 0), kf);\r\n\tvR = mix(peek(tape, k0, tch), peek(tape, k1, tch), kf);\r\n\tmono = (vL + vR) * 0.5;\r\n\tgg = hen * edge;\r\n\tsumL += mono * sqrt(1 - hpn) * gg;\r\n\tsumR += mono * sqrt(hpn) * gg;\r\n\tif (i == 0) {\r\n\t\th0 = rpos / tl;\r\n\t}\r\n\tpoke(hd, hls, i, 0);\r\n\tpoke(hd, hll, i, 1);\r\n\tpoke(hd, hrel, i, 2);\r\n\tpoke(hd, hsp, i, 3);\r\n\tpoke(hd, htm, i, 4);\r\n\tpoke(hd, hen, i, 5);\r\n\tpoke(hd, hst, i, 6);\r\n\tpoke(hd, hpn, i, 7);\r\n}\r\n\r\n// erosion on the way back to tape: darker, saturated, a little hiss\r\ncut = mix(0.9, 0.035, clamp(erode, 0, 1));\r\na1 = lp1 + (sumL * 0.6 - lp1) * cut;\r\na2 = lp2 + (sumR * 0.6 - lp2) * cut;\r\ndrv = 1 + 3 * erode;\r\neL = tanh(a1 * drv) / drv + noise() * erode * 0.0015;\r\neR = tanh(a2 * drv) / drv + noise() * erode * 0.0015;\r\nfb = clamp(feedback, 0, 0.99);\r\nif (freeze < 0.5) {\r\n\tpoke(tape, inL + eL * fb, w, 0);\r\n\tif (tch > 0) {\r\n\t\tpoke(tape, inR + eR * fb, w, 1);\r\n\t}\r\n\tw = wrap(w + 1, 0, tl);\r\n\tfd = min(fd + 1, tl);\r\n}\r\n\r\noL = inL * dry + sumL;\r\noR = inR * dry + sumR;\r\nyL = oL - dcx1 + 0.9995 * dcy1;\r\nyR = oR - dcx2 + 0.9995 * dcy2;\r\ndcx1 = oL;\r\ndcy1 = yL;\r\ndcx2 = oR;\r\ndcy2 = yR;\r\n\r\nout1 = yL * level;\r\nout2 = yR * level;\r\nout3 = w / tl;\r\nout4 = h0;\r\n\r\nwp = w;\r\nfpos = fp;\r\nfilled = fd;\r\nlp1 = a1;\r\nlp2 = a2;\r\nwowph = wph;\r\n",
                  "fontface": 0,
                  "fontname": "<Monospaced>",
                  "fontsize": 12.0,
                  "numinlets": 2,
                  "numoutlets": 4,
                  "outlettype": [
