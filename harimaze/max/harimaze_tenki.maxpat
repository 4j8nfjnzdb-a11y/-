            "subpatcher_template": "",
            "assistshowspatchername": 0,
            "boxes": [
              {
                "box": {
                  "maxclass": "codebox",
                  "code": "// harimaze / TENKI - loop weather\r\n// One loop window over a buffer. A weather process keeps changing it:\r\n// tape stops, rewinds, leaps back in time, freezes into a micro loop.\r\n// in1  : trigger (rising edge forces a weather event now)\r\n// out1 : left    out2 : right\r\n// out3 : play position 0..1\r\n// out4 : weather 0 calm, 1 tape stop, 2 rewind, 3 freeze, 4 leap\r\n\r\nBuffer src(\"hz_tenki_src\");\r\n\r\nParam speed(1);\r\nParam start(0.1);\r\nParam size(0.25);\r\nParam drift(0.2);\r\nParam weather(0.35);\r\nParam tapestop(0.5);\r\nParam rewind(0.4);\r\nParam leap(0.4);\r\nParam freeze(0.3);\r\nParam glide(250);\r\nParam xfade(20);\r\nParam level(0.8);\r\n\r\nHistory rpos(0);\r\nHistory gpos(0);\r\nHistory gfade(0);\r\nHistory spd(1);\r\nHistory wander(0);\r\nHistory wvel(0);\r\nHistory wtgt(0);\r\nHistory plst(0);\r\nHistory lastap(0);\r\nHistory offs(0);\r\nHistory mode(0);\r\nHistory mtimer(0);\r\nHistory etimer(44100);\r\nHistory frz(800);\r\nHistory ramt(1);\r\nHistory flash(0);\r\nHistory trigprev(0);\r\nHistory dcx1(0);\r\nHistory dcy1(0);\r\nHistory dcx2(0);\r\nHistory dcy2(0);\r\n\r\nblen = max(dim(src), 2);\r\nch2 = 0;\r\nif (channels(src) > 1) {\r\n\tch2 = 1;\r\n}\r\n\r\nrp = rpos;\r\ng = gpos;\r\ngf = gfade;\r\nsp = spd;\r\nwd = wander;\r\nwv = wvel;\r\nwt = wtgt;\r\nof = offs;\r\nmd = mode;\r\nmt = mtimer;\r\net = etimer - 1;\r\nfz = frz;\r\nra = ramt;\r\nfl = max(flash - 1, 0);\r\nr = 0;\r\nleapnow = 0;\r\ntrig = (in1 > 0.5) * (trigprev <= 0.5);\r\nwsum = tapestop + rewind + leap + freeze;\r\n\r\n// drift: the window slides at a slowly changing speed (at most a few\r\n// percent of real time, so it reads as tape wow), pulled gently home\r\nif (noise() > 0.9999) {\r\n\twt = noise() * drift * 0.04;\r\n}\r\nwv = wv + (wt - wv) * 0.0001;\r\nwd = clamp(wd + wv / blen - wd * 0.000002, -0.5, 0.5);\r\n\r\n// weather engine: pick the next event\r\nif (et <= 0 || trig > 0) {\r\n\tet = mstosamps(mix(8000, 150, clamp(weather, 0, 1)) * (0.4 + 1.2 * (noise() * 0.5 + 0.5)));\r\n\tif (md == 0 && wsum > 0.001 && (weather > 0.001 || trig > 0)) {\r\n\t\tr = (noise() * 0.5 + 0.5) * wsum;\r\n\t\tif (r < tapestop) {\r\n\t\t\tmd = 1;\r\n\t\t\tmt = mstosamps(300 + 1500 * (noise() * 0.5 + 0.5));\r\n\t\t} else if (r < tapestop + rewind) {\r\n\t\t\tmd = 2;\r\n\t\t\tmt = mstosamps(400 + 2500 * (noise() * 0.5 + 0.5));\r\n\t\t\tra = 0.5 + 1.5 * (noise() * 0.5 + 0.5);\r\n\t\t} else if (r < tapestop + rewind + leap) {\r\n\t\t\tleapnow = 1;\r\n\t\t} else {\r\n\t\t\tmd = 3;\r\n\t\t\tmt = mstosamps(500 + 3000 * (noise() * 0.5 + 0.5));\r\n\t\t\tfz = mstosamps(15 + 120 * (noise() * 0.5 + 0.5));\r\n\t\t}\r\n\t}\r\n}\r\nif (md != 0) {\r\n\tmt = mt - 1;\r\n\tif (mt <= 0) {\r\n\t\tmd = 0;\r\n\t}\r\n}\r\n\r\n// speed glides toward its target like a tape transport\r\ntgt = speed;\r\nif (md == 1) {\r\n\ttgt = 0;\r\n}\r\nif (md == 2) {\r\n\ttgt = 0 - speed * ra;\r\n}\r\ncoef = 1 - exp(-1 / max(mstosamps(glide), 1));\r\nsp = sp + (tgt - sp) * coef;\r\n\r\n// leap: jump the window back in time, or return to the present\r\nif (leapnow > 0) {\r\n\tif (of != 0 && noise() > 0) {\r\n\t\tof = 0;\r\n\t} else {\r\n\t\tof = wrap(of - (0.05 + 0.4 * (noise() * 0.5 + 0.5)), 0, 1);\r\n\t}\r\n\tfl = mstosamps(250);\r\n}\r\nlst = wrap(start + wd + of, 0, 1) * blen;\r\nlsz = clamp(size, 0.0005, 1) * blen;\r\nif (md == 3) {\r\n\tlsz = min(fz, lsz);\r\n}\r\nlsz = max(lsz, 32);\r\nxf = max(min(mstosamps(xfade), lsz * 0.5 / max(abs(sp), 1)), 1);\r\n\r\n// advance; when the window jumps (leap, a new start) or the loop reaches\r\n// its seam, a ghost head carries on from the old place and fades out\r\ng = wrap(g + sp, 0, blen);\r\ngf = max(gf - 1 / xf, 0);\r\ndl = abs(wrap(lst - plst, blen * -0.5, blen * 0.5));\r\nif (dl > 64) {\r\n\tg = wrap(lastap + sp, 0, blen);\r\n\tgf = 1;\r\n}\r\nrp = rp + sp;\r\nif (rp >= lsz || rp < 0) {\r\n\tg = wrap(lst + rp, 0, blen);\r\n\tgf = 1;\r\n\trp = wrap(rp, 0, lsz);\r\n}\r\n\r\nap = wrap(lst + rp, 0, blen);\r\ni0 = floor(ap);\r\nfr = ap - i0;\r\ni1 = wrap(i0 + 1, 0, blen);\r\nmL = mix(peek(src, i0, 0), peek(src, i1, 0), fr);\r\nmR = mix(peek(src, i0, ch2), peek(src, i1, ch2), fr);\r\nj0 = floor(g);\r\ngr = g - j0;\r\nj1 = wrap(j0 + 1, 0, blen);\r\ngL = mix(peek(src, j0, 0), peek(src, j1, 0), gr);\r\ngR = mix(peek(src, j0, ch2), peek(src, j1, ch2), gr);\r\nka = sqrt(1 - gf);\r\nkb = sqrt(gf);\r\noL = mL * ka + gL * kb;\r\noR = mR * ka + gR * kb;\r\n\r\n// dc blocker (a stopped tape holds a constant value)\r\nyL = oL - dcx1 + 0.9995 * dcy1;\r\nyR = oR - dcx2 + 0.9995 * dcy2;\r\ndcx1 = oL;\r\ndcy1 = yL;\r\ndcx2 = oR;\r\ndcy2 = yR;\r\n\r\nst = md;\r\nif (fl > 0) {\r\n\tst = 4;\r\n}\r\nout1 = yL * level;\r\nout2 = yR * level;\r\nout3 = ap / blen;\r\nout4 = st;\r\n\r\nrpos = rp;\r\ngpos = g;\r\ngfade = gf;\r\nspd = sp;\r\nwander = wd;\r\nwvel = wv;\r\nwtgt = wt;\r\nplst = lst;\r\nlastap = ap;\r\noffs = of;\r\nmode = md;\r\nmtimer = mt;\r\netimer = et;\r\nfrz = fz;\r\nramt = ra;\r\nflash = fl;\r\ntrigprev = in1;\r\n",
                  "fontface": 0,
                  "fontname": "<Monospaced>",
