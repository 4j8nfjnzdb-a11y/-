            ],
            "gridsnaponopen": 1,
            "objectsnaponopen": 1,
            "statusbarvisible": 2,
            "toolbarvisible": 1,
            "lefttoolbarpinned": 0,
            "toptoolbarpinned": 0,
            "righttoolbarpinned": 0,
            "bottomtoolbarpinned": 0,
            "toolbars_unpinned_last_save": 0,
            "tallnewobj": 0,
            "boxanimatetime": 200,
            "enablehscroll": 1,
            "enablevscroll": 1,
            "devicewidth": 0.0,
            "description": "",
            "digest": "",
            "tags": "",
            "style": "",
            "subpatcher_template": "",
            "assistshowspatchername": 0,
            "boxes": [
              {
                "box": {
                  "maxclass": "codebox",
                  "code": "// harimaze / KIRI - cut-up sequencer\r\n// The source is cut into equal slices and a 16 step pattern plays them.\r\n// Each step stores slice, direction, pitch, ratchet and rest. At the end of\r\n// every cycle some steps mutate, so the collage keeps rewriting itself.\r\n// Order 0 keeps the slices in their original order; 1 shuffles them.\r\n// Change reroll to any new value to rewrite the whole pattern.\r\n// in1  : clock (rising edge advances one step; pair it with a slow bpm)\r\n// out1 : left    out2 : right\r\n// out3 : step 0..1    out4 : slice 0..1\r\n\r\nBuffer src(\"hz_kiri_src\");\r\nData pat(16, 5);\r\n\r\nParam bpm(96);\r\nParam slices(16);\r\nParam steps(16);\r\nParam order(0.5);\r\nParam mutate(0.15);\r\nParam rest(0.15);\r\nParam rev(0.2);\r\nParam pitch(0.3);\r\nParam ratchet(0.15);\r\nParam gatelen(0.85);\r\nParam swing(0);\r\nParam reroll(0);\r\nParam level(0.8);\r\n\r\nHistory cnt(0);\r\nHistory stp(0);\r\nHistory inited(0);\r\nHistory rrprev(0);\r\nHistory trigprev(0);\r\n\r\nblen = max(dim(src), 2);\r\nch2 = 0;\r\nif (channels(src) > 1) {\r\n\tch2 = 1;\r\n}\r\nns = clamp(floor(slices), 1, 64);\r\nnst = clamp(floor(steps), 1, 16);\r\nslen = blen / ns;\r\nbase = samplerate * 15 / clamp(bpm, 20, 400);\r\nc = cnt + 1;\r\ns = stp;\r\ntrig = (in1 > 0.5) * (trigprev <= 0.5);\r\npm = 0;\r\ndoit = 0;\r\nj = 0;\r\nsv = 0;\r\ndv = 1;\r\nsemi = 0;\r\ndg = 0;\r\noc = 0;\r\nrv = 1;\r\nov = 1;\r\nordslice = 0;\r\nrnds = 0;\r\n\r\nif (inited < 0.5 || reroll != rrprev) {\r\n\tpm = 1;\r\n\tdoit = 1;\r\n}\r\n\r\n// clock with swing on the off-beats\r\nodd = s - 2 * floor(s / 2);\r\nsw = 1 + clamp(swing, 0, 0.9) * 0.5;\r\nif (odd > 0.5) {\r\n\tsw = 1 - clamp(swing, 0, 0.9) * 0.5;\r\n}\r\nsl = base * sw;\r\nif (c >= sl || trig > 0) {\r\n\tc = 0;\r\n\ts = s + 1;\r\n\tif (s >= nst) {\r\n\t\ts = 0;\r\n\t\tif (doit < 1) {\r\n\t\t\tpm = clamp(mutate, 0, 1);\r\n\t\t\tdoit = 1;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n// write or mutate the pattern\r\nif (doit > 0) {\r\n\tfor (j = 0; j < 16; j += 1) {\r\n\t\tif ((noise() * 0.5 + 0.5) < pm) {\r\n\t\t\tordslice = j - ns * floor(j / ns);\r\n\t\t\trnds = floor((noise() * 0.5 + 0.5) * ns);\r\n\t\t\tsv = ordslice;\r\n\t\t\tif ((noise() * 0.5 + 0.5) < order) {\r\n\t\t\t\tsv = rnds;\r\n\t\t\t}\r\n\t\t\tdv = 1;\r\n\t\t\tif ((noise() * 0.5 + 0.5) < rev) {\r\n\t\t\t\tdv = -1;\r\n\t\t\t}\r\n\t\t\tsemi = 0;\r\n\t\t\tif ((noise() * 0.5 + 0.5) < pitch) {\r\n\t\t\t\t// pentatonic by fifths: 0 7 2 9 4, one octave down to one up\r\n\t\t\t\tdg = floor((noise() * 0.5 + 0.5) * 5);\r\n\t\t\t\tsemi = dg * 7 - 12 * floor(dg * 7 / 12);\r\n\t\t\t\toc = floor((noise() * 0.5 + 0.5) * 3) - 1;\r\n\t\t\t\tsemi = semi + oc * 12;\r\n\t\t\t\tif (semi > 12) {\r\n\t\t\t\t\tsemi = semi - 12;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\trv = 1;\r\n\t\t\tif ((noise() * 0.5 + 0.5) < ratchet) {\r\n\t\t\t\trv = 2 + floor((noise() * 0.5 + 0.5) * 3);\r\n\t\t\t}\r\n\t\t\tov = 1;\r\n\t\t\tif (j > 0 && (noise() * 0.5 + 0.5) < rest) {\r\n\t\t\t\tov = 0;\r\n\t\t\t}\r\n\t\t\tpoke(pat, sv, j, 0);\r\n\t\t\tpoke(pat, dv, j, 1);\r\n\t\t\tpoke(pat, semi, j, 2);\r\n\t\t\tpoke(pat, rv, j, 3);\r\n\t\t\tpoke(pat, ov, j, 4);\r\n\t\t}\r\n\t}\r\n}\r\n\r\n// play the current step\r\ncsl = peek(pat, s, 0);\r\ncsl = csl - ns * floor(csl / ns);\r\ncdr = peek(pat, s, 1);\r\ncse = peek(pat, s, 2);\r\ncrt = max(peek(pat, s, 3), 1);\r\ncon = peek(pat, s, 4);\r\nsubl = sl / crt;\r\nlc = c - subl * floor(c / subl);\r\nrt = pow(2, cse / 12);\r\nrel = wrap(lc * rt, 0, slen);\r\nsst = csl * slen;\r\nrd = sst + rel;\r\nif (cdr < 0) {\r\n\trd = sst + slen - 1 - rel;\r\n}\r\nrd = wrap(rd, 0, blen);\r\natk = mstosamps(2);\r\nrls = mstosamps(8);\r\nglen = subl * clamp(gatelen, 0.05, 1);\r\nen = clamp(lc / atk, 0, 1) * clamp((glen - lc) / rls, 0, 1);\r\nif (con < 0.5) {\r\n\ten = 0;\r\n}\r\ni0 = floor(rd);\r\nfr = rd - i0;\r\ni1 = wrap(i0 + 1, 0, blen);\r\noL = mix(peek(src, i0, 0), peek(src, i1, 0), fr) * en;\r\noR = mix(peek(src, i0, ch2), peek(src, i1, ch2), fr) * en;\r\n\r\nout1 = oL * level;\r\nout2 = oR * level;\r\nout3 = s / 16;\r\nout4 = csl / ns;\r\n\r\ncnt = c;\r\nstp = s;\r\ninited = 1;\r\nrrprev = reroll;\r\ntrigprev = in1;\r\n",
                  "fontface": 0,
                  "fontname": "<Monospaced>",
                  "fontsize": 12.0,
