# musubime: @NAME@ on fm1-base (tools/build.py). Generated by fm1/assemble.sh from fm1/fm1.toml.in.
name = "@NAME@"
id_prefix = "@ID@"                    # dev builds @ID@00; pick your own before sharing (the Firmware Hub lists taken ones)
usb_manufacturer = "musubime"
usb_product = "@NAME@ FM-1"
o2 = ["src/*.c"]                       # the shell, the body, the screen and the project: the DSP at -O2
o2_cflags = ["-DMZ_FM1"@EXTRA_CFLAGS@]               # big buffers into the .pool RAM region (mz.h MZ_POOL); MZ_ALL: all six
include = ["src"]
words = "words.tsv"
ble = false                            # no Bluetooth: smaller, and no JieLi library linked
tagline = "@TAGLINE@"
